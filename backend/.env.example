# Backend Configuration
PROJECT_NAME="UEBA Threat Detection API"
API_V1_PREFIX="/api/v1"
DEBUG=true

# Database Configuration
# Default to SQLite for standalone zero-config execution; replace with PostgreSQL URL for production
DATABASE_URL=sqlite:///./ueba.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ueba_db

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Paths
DATA_DIR=../data
RAW_DATA_DIR=../data/raw
PROCESSED_DATA_DIR=../data/processed
MODELS_DIR=./artifacts

# Dataset locations (raw data is never committed)
SPEDIA_FILE=../data/raw/spedia/logs_SPEDIA_annotated_en.csv
CERT_R42_DIR=../data/raw/r4.2

# Ingestion
INGEST_CHUNK_SIZE=50000
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
INTERNAL_EMAIL_DOMAINS=dtaa.com

# Personal baselines (provisional defaults)
BASELINE_MIN_SAMPLES=14
BASELINE_MAX_WINDOW_DAYS=90
BASELINE_SCALE_FLOOR=1.0

# Optional JSON file with risk weights/thresholds (provisional defaults used if unset)
# RISK_CONFIG_PATH=./risk_config.json
