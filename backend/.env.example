# Backend Configuration
PROJECT_NAME="UEBA Threat Detection API"
API_V1_PREFIX="/api/v1"
DEBUG=true

# Database Configuration
# Default to SQLite for standalone zero-config execution; replace with PostgreSQL URL for production
DATABASE_URL=sqlite:///./ueba.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ueba_db

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Paths
DATA_DIR=../data
RAW_DATA_DIR=../data/raw
PROCESSED_DATA_DIR=../data/processed
MODELS_DIR=./artifacts
